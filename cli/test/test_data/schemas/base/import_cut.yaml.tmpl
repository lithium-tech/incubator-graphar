graphar:
  path: ${GRAPHAR_RESULT}
  name: Graph
  validate_level: weak
  version: gar/v1
  vertex_chunk_size: 10
  edge_chunk_size: 20
  file_type: parquet

import_schema:
  vertices:
    - type: person
      property_groups:
        - file_type: parquet
          properties:
            - name: passport
              data_type: int64
              is_primary: true
              nullable: false
            - name: full_name
              data_type: string
              nullable: false
      sources:
        - path:  ${ROOT_DIR}/cli/test/test_data/input/data/persons.csv
          columns:
            passport: passport
            full_name: full_name
    - type: movie
      property_groups:
        - file_type: parquet
          properties:
            - name: movie_id
              data_type: int32
              is_primary: true
              nullable: false
            - name: title
              data_type: string
              nullable: false
      sources:
        - path:  ${ROOT_DIR}/cli/test/test_data/input/data/movies.csv
          columns:
            movie_id: movie_id
            title: title
  edges:
    - edge_type: directed
      src_type: person
      src_prop: passport
      src_edge_prop: passport
      dst_type: movie
      dst_prop: movie_id
      dst_edge_prop: movie_id
      prefix: edge/person_directed_movie/
      adj_lists:
        - ordered: true
          aligned_by: src
          file_type: parquet
        - ordered: true
          aligned_by: dst
          file_type: parquet
      sources:
        - path:  ${ROOT_DIR}/cli/test/test_data/input/data/directed_nulls.csv
          columns:
            passport: passport
            movie_id: movie_id
    - edge_type: rated
      src_type: person
      src_prop: passport
      src_edge_prop: passport
      dst_type: movie
      dst_prop: movie_id
      dst_edge_prop: movie_id
      prefix: edge/person_rated_movie/
      adj_lists:
        - ordered: true
          aligned_by: src
          file_type: parquet
        - ordered: true
          aligned_by: dst
          file_type: parquet
      property_groups:
        - file_type: parquet
          properties:
            - name: rating
              data_type: int32
              is_primary: false
              nullable: true
      sources:
        - path:  ${ROOT_DIR}/cli/test/test_data/input/data/rated.csv
          columns:
            passport: passport
            movie_id: movie_id
            rating: rating
    - edge_type: knows
      src_type: person
      src_prop: passport
      src_edge_prop: person1
      dst_type: person
      dst_prop: passport
      dst_edge_prop: person2
      prefix: edge/person_knows_person/
      adj_lists:
        - ordered: true
          aligned_by: src
          file_type: parquet
        - ordered: true
          aligned_by: dst
          file_type: parquet
      sources:
        - path:  ${ROOT_DIR}/cli/test/test_data/input/data/knows.csv
          columns:
            person1: person1
            person2: person2
